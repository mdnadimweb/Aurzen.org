# Copy to .env for local Compose. Never commit filled-in values.
# All three secrets are mandatory. Generate each independently with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
INTERNAL_API_TOKEN=
ADMIN_PASSWORD=
CHECKOUT_ENABLED=false

# PostgreSQL password used by compose.yaml (keep it to letters, digits, - and _).
POSTGRES_PASSWORD=

# npm run dev: set a postgres:// URL to use PostgreSQL; leave empty for local SQLite.
# Compose builds this value itself from POSTGRES_PASSWORD.
DATABASE_URL=

# Optional: source for npm run migrate:postgres, or hosted storage instead of SQLite.
# Ignored by the app when DATABASE_URL is set.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# The following are for npm run dev only; Compose fixes its own service values.
INTERNAL_API_URL=http://127.0.0.1:4000
DATABASE_PATH=data/aurzen.sqlite
COOKIE_SECURE=false
SEED_DEMO=false
API_PORT=4000
WEB_PORT=3000
